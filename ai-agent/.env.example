# Copia in .env e adatta. Tutte le variabili hanno il prefisso PRESTO_AI_.
PRESTO_AI_OLLAMA_BASE_URL=http://localhost:11434
PRESTO_AI_MODEL=qwen2.5:3b
# Facoltativo, per "Compila con l'AI" nel modulo di inserimento: ollama pull qwen2.5vl:3b
PRESTO_AI_VISION_MODEL=qwen2.5vl:3b
PRESTO_AI_LARAVEL_URL=http://localhost:8000
# Stesso valore di AI_AGENT_TOKEN nel .env di Laravel
PRESTO_AI_API_TOKEN=
# Oscuramento dei volti (rilevatore locale, non serve Ollama): soglia e margine dei riquadri
PRESTO_AI_FACE_THRESHOLD=0.6
PRESTO_AI_FACE_MARGIN=0.25
