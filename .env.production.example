# Base per la produzione: copia in .env sul server e compila i valori vuoti.
APP_NAME="Presto.it"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Con https://: cookie di sessione solo su HTTPS. Le richieste con un altro dominio vengono rifiutate
APP_URL=https://

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Utente dedicato con i soli permessi sul database del sito, mai root
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

SCOUT_DRIVER=tntsearch
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mai "log" in produzione: link di reset e di verifica finirebbero nei file di log
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Secondi tra un'email e l'altra: da adattare al limite del provider
MAIL_SECONDS_BETWEEN_SENDS=1
# Chi riceve le richieste per diventare revisore
ADMIN_EMAIL=

# Agente AI: token lungo e casuale (openssl rand -hex 32), uguale a PRESTO_AI_API_TOKEN in ai-agent/.env
AI_AGENT_URL=http://127.0.0.1:8001
AI_AGENT_TOKEN=

# Reverb: valori nuovi, mai quelli di .env.example (php artisan reverb:install)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
